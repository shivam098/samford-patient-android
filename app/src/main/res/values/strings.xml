    <!-- Welcome and sign-in -->
    <string name="welcome_tagline">Your OPD records from Samford Hospital, Ranchi: the doctor\'s own handwriting, on your phone. No paper to keep or lose.</string>
    <string name="welcome_sign_in">Sign in with mobile number</string>
    <string name="welcome_explore_sample">Explore sample records (offline)</string>
    <string name="welcome_preparing_sample">Preparing sample records…</string>
    <string name="welcome_sample_explainer">Sample records are made up and stored only on this phone, so you can try the app without the hospital server.</string>
    <string name="sign_in_title">Sign in</string>
    <string name="sign_in_mobile_intro">Enter the mobile number registered at Samford Hospital. We will send a one-time code.</string>
    <string name="sign_in_mobile_label">Mobile number</string>
    <string name="sign_in_send_code">Send code</string>
    <string name="sign_in_demo_numbers_intro">Testing? Tap a demo number. These synthetic numbers exist on every Samford demo server.</string>
    <string name="sign_in_code_intro">Enter the 6-digit code sent to %1$s.</string>
    <string name="sign_in_demo_code_title">DEMO CODE (no SMS is sent)</string>
    <string name="sign_in_demo_code_explainer">This demo has no SMS service, so the server shows the code here. In a real hospital app it would arrive by SMS.</string>
    <string name="sign_in_fill_demo_code">Use demo code</string>
    <string name="sign_in_code_label">6-digit code</string>
